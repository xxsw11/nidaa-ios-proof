                "alert_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "event_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "kind": {
                  "enum": [
                    "app_acknowledged",
                    "opened"
                  ]
                }
              },
              "required": [
                "alert_id",
                "event_id",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "operation_id",
            "issued_at",
            "command",
            "payload"
          ],
          "additionalProperties": false
