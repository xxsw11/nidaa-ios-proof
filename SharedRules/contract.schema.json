    "Receipt": {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "resource_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "error": {
          "enum": [
            null,
            "invalid_request",
            "unauthenticated",
            "not_found",
            "forbidden",
            "conflict",
            "expired",
            "rate_limited",
            "consent_required",
            "terminal",
            "limit_reached",
            "reauthentication_required"
          ]
        },
        "server_time": {
          "type": "integer",
          "minimum": 0
        },
        "invitation_token": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "operation_id",
        "status",
        "resource_id",
        "error",
        "server_time",
        "invitation_token"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "enum": [
                  "invalid_request",
                  "unauthenticated",
                  "not_found",
                  "forbidden",
                  "conflict",
                  "expired",
                  "rate_limited",
                  "consent_required",
                  "terminal",
                  "limit_reached",
                  "reauthentication_required"
                ]
              },
              "resource_id": {
                "type": "null"
              },
              "invitation_token": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Alert": {
      "type": "object",
      "properties": {
        "alert_id": {
          "type": "string",
          "format": "uuid"
        },
        "sender_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "active",
            "cancelled",
            "resolved",
            "expired"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0
        },
        "closed_at": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string",
                "format": "uuid"
              },
              "response": {
                "enum": [
                  "none",
                  "responding",
                  "declined"
                ]
              },
              "response_version": {
                "type": "integer",
                "minimum": 0
              },
              "access": {
                "enum": [
                  "active",
                  "unavailable"
                ]
              },
              "provider_accepted": {
                "type": "boolean"
              },
              "app_acknowledged": {
                "type": "boolean"
              },
              "opened": {
                "type": "boolean"
              }
            },
            "required": [
              "user_id",
              "response",
              "response_version",
              "access",
              "provider_accepted",
              "app_acknowledged",
              "opened"
            ],
            "additionalProperties": false
          },
          "maxItems": 5
        }
      },
      "required": [
        "alert_id",
        "sender_id",
        "state",
        "version",
        "expires_at",
        "closed_at",
        "recipients"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "enum": [
            "invalid_request",
            "unauthenticated",
            "not_found",
            "forbidden",
            "conflict",
            "expired",
            "rate_limited",
            "consent_required",
            "terminal",
            "limit_reached",
            "reauthentication_required"
          ]
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "Account": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "display_name": {
          "type": "string",
          "maxLength": 80
