              },
              "state": {
                "enum": [
                  "pending",
                  "accepted",
                  "declined",
                  "expired",
                  "cancelled",
                  "blocked",
                  "withdrawn",
                  "unavailable"
                ]
              },
              "expires_at": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "invitation_id",
              "sender_id",
              "direction",
              "state",
              "expires_at"
            ],
            "additionalProperties": false
          }
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sender_id": {
                "type": "string",
                "format": "uuid"
              },
              "recipient_id": {
                "type": "string",
                "format": "uuid"
              },
              "state": {
                "enum": [
                  "accepted",
                  "unavailable"
                ]
              }
            },
            "required": [
              "sender_id",
              "recipient_id",
              "state"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "invitations",
        "grants"
      ],
      "additionalProperties": false
    },
    "Sync": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "alert_id": {
                "type": "string",
                "format": "uuid"
              },
              "sender_id": {
                "type": "string",
                "format": "uuid"
              },
              "state": {
                "enum": [
                  "active",
                  "cancelled",
                  "resolved",
                  "expired"
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "expires_at": {
                "type": "integer",
                "minimum": 0
              },
              "closed_at": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "recipients": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "response": {
                      "enum": [
                        "none",
                        "responding",
                        "declined"
                      ]
                    },
                    "response_version": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "access": {
                      "enum": [
                        "active",
                        "unavailable"
                      ]
                    },
                    "provider_accepted": {
                      "type": "boolean"
                    },
                    "app_acknowledged": {
                      "type": "boolean"
                    },
                    "opened": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "user_id",
                    "response",
                    "response_version",
                    "access",
                    "provider_accepted",
                    "app_acknowledged",
                    "opened"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 5
              }
            },
            "required": [
              "alert_id",
              "sender_id",
              "state",
              "version",
              "expires_at",
              "closed_at",
              "recipients"
            ],
            "additionalProperties": false
          }
        },
        "removed_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "full_snapshot": {
          "const": true
        }
      },
      "required": [
        "cursor",
        "alerts",
        "removed_ids",
        "full_snapshot"
      ],
      "additionalProperties": false
    }
  }
}
